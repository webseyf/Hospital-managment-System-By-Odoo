<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hospital" model="ir.module.category">
        <field name="name">Hospital Management</field>
        <field name="description">Category for Hospital Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_hospital" model="res.groups.privilege">
        <field name="name">Hospital Management Privilege</field>
        <field name="category_id" ref="om_hospital.module_category_hospital"/>
    </record>

    <record id="group_hospital_user" model="res.groups">
        <field name="name">Hospital Staff (General)</field>
        <field name="privilege_id" ref="om_hospital.privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hospital_nurse" model="res.groups">
        <field name="name">Hospital Nurse</field>
        <field name="privilege_id" ref="om_hospital.privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('om_hospital.group_hospital_user'))]"/>
    </record>

    <record id="group_hospital_pharmacist" model="res.groups">
        <field name="name">Hospital Pharmacist</field>
        <field name="privilege_id" ref="om_hospital.privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('om_hospital.group_hospital_user'))]"/>
    </record>

    <record id="group_hospital_doctor" model="res.groups">
        <field name="name">Hospital Doctor</field>
        <field name="privilege_id" ref="om_hospital.privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('om_hospital.group_hospital_user'))]"/>
    </record>

    <record id="group_hospital_receptionist" model="res.groups">
        <field name="name">Hospital Receptionist</field>
        <field name="privilege_id" ref="om_hospital.privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('om_hospital.group_hospital_user'))]"/>
    </record>

    <record id="group_hospital_manager" model="res.groups">
        <field name="name">Hospital Administrator</field>
        <field name="privilege_id" ref="om_hospital.privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('om_hospital.group_hospital_user'))]"/>
    </record>
</odoo>
