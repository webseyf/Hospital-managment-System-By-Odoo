<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_discharge_summary_form" model="ir.ui.view">
        <field name="name">hospital.discharge.summary.form</field>
        <field name="model">hospital.discharge.summary</field>
        <field name="arch" type="xml">
            <form string="Discharge Summary">
                <header>
                    <field name="is_discharged" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="appointment_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="doctor_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="admission_date" readonly="1"/>
                            <field name="discharge_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clinical Summary" name="clinical">
                            <group>
                                <field name="final_diagnosis"/>
                                <field name="clinical_summary"/>
                            </group>
                        </page>
                        <page string="Treatment &amp; Follow-up" name="treatment">
                            <group>
                                <field name="treatment_given"/>
                                <field name="followup_instructions"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_discharge_summary_tree" model="ir.ui.view">
        <field name="name">hospital.discharge.summary.tree</field>
        <field name="model">hospital.discharge.summary</field>
        <field name="arch" type="xml">
            <list string="Discharge Summaries">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="discharge_date"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_discharge_summary" model="ir.actions.act_window">
        <field name="name">Discharge Summaries</field>
        <field name="res_model">hospital.discharge.summary</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
