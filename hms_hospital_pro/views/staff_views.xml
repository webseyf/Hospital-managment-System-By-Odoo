<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_staff_tree" model="ir.ui.view">
        <field name="name">hospital.staff.list</field>
        <field name="model">hospital.staff</field>
        <field name="arch" type="xml">
            <list string="Staff">
                <field name="name"/>
                <field name="role" widget="badge"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_staff_form" model="ir.ui.view">
        <field name="name">hospital.staff.form</field>
        <field name="model">hospital.staff</field>
        <field name="arch" type="xml">
            <form string="Staff">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Staff Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="role"/>
                            <field name="department_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hospital_staff" model="ir.actions.act_window">
        <field name="name">Hospital Staff</field>
        <field name="res_model">hospital.staff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your hospital staff here.</p>
        </field>
    </record>
</odoo>
